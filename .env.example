# Copy to .env and fill in. NEVER commit .env or *.pem files.

NODE_ENV=development
PORT=3000
# Public base URL of the app (used for OAuth callback + webhook URL)
APP_URL=http://localhost:3000

# Neon Postgres connection string (step 2)
DATABASE_URL=

# AES-256-GCM key for encrypting Slack webhook URLs at rest: `openssl rand -hex 32`
ENCRYPTION_KEY=

# GitHub App (step 3)
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# Private key PEM with newlines escaped as \n (single line)
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_SLUG=
# Webhook secret configured on the GitHub App: `openssl rand -hex 32`
GITHUB_WEBHOOK_SECRET=

# AI triage (step 8) - Google AI Studio free key
GEMINI_API_KEY=
# Optional. The "latest" alias survives Google retiring specific model versions.
GEMINI_MODEL=gemini-flash-lite-latest
